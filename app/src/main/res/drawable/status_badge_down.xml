<?xml version="1.0" encoding="utf-8"?>
<!-- The DOWN badge and the OFF badge are mutually exclusive, so the user never sees them side by
     side and cannot compare the two reds. The label is what distinguishes them: "DOWN" means the
     firewall failed, "OFF" means the user switched it off. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/firewall_down_red" />
    <corners android:radius="4dp" />
</shape>
